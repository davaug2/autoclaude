# =============================================================================
# ask-the-code — exemplo de configuração
# =============================================================================
# Copie para .env e preencha. NUNCA faça commit do .env.

# -----------------------------------------------------------------------------
# repo-sync
# -----------------------------------------------------------------------------
# URL HTTPS do repositório privado, sem credenciais embutidas
GIT_REPO_URL=https://github.com/sua-org/seu-repo.git

# Branch a sincronizar (default: main)
GIT_BRANCH=main

# Personal Access Token com escopo 'repo' (read). Usado apenas internamente.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Intervalo de pull em segundos (default: 300 = 5min)
SYNC_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado pelo agente. Confira https://docs.claude.com/en/docs/models para
# o id atual. Defaults razoáveis:
#   claude-opus-4-7         (mais capaz, mais caro)
#   claude-sonnet-4-6       (balanced)
#   claude-haiku-4-5        (rápido/barato)
ANTHROPIC_MODEL=claude-opus-4-7

AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT_S=180
REWRITE_MAX_TOKENS=2048

# Quantas tentativas de reescrita antes de desistir. Default 2.
MAX_REWRITE_ATTEMPTS=2

# -----------------------------------------------------------------------------
# Rate limiting (Redis)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=30

# -----------------------------------------------------------------------------
# MCP / leitura do repo (claude-code-mcp)
# -----------------------------------------------------------------------------
# Máximo de bytes que read_file pode retornar (default 256 KB)
MAX_READ_BYTES=262144
# Máximo de hits do grep
MAX_GREP_RESULTS=200
# Máximo de matches do glob
MAX_GLOB_RESULTS=500

# -----------------------------------------------------------------------------
# Input scanners (LLM Guard)
# -----------------------------------------------------------------------------
INPUT_TOKEN_LIMIT=2000
PROMPT_INJECTION_THRESHOLD=0.5
INPUT_TOXICITY_THRESHOLD=0.7

# Lista separada por vírgula
BANNED_TOPICS=personal advice,medical,legal,financial advice

# -----------------------------------------------------------------------------
# Output scanners (LLM Guard)
# -----------------------------------------------------------------------------
OUTPUT_TOXICITY_THRESHOLD=0.7
OUTPUT_BIAS_THRESHOLD=0.7
MALICIOUS_URL_THRESHOLD=0.7

# Regex que BLOQUEIAM a resposta inteira se casarem (JSON list).
# Ex: ["NOME_INTERNO_DO_PRODUTO","CONFIDENTIAL-[0-9]+"]
OUTPUT_BLOCK_REGEX_PATTERNS=[]

# Regex que são SANITIZADOS (substituídos por [REDACTED]) na resposta (JSON list).
# Ex: ["CUST-[0-9]{8}","internal_id_\\d+"]
OUTPUT_REDACT_REGEX_PATTERNS=[]

# Ligar/desligar o scanner de recusa do modelo
ENABLE_NO_REFUSAL=false

# -----------------------------------------------------------------------------
# Observabilidade (Langfuse — opcional)
# -----------------------------------------------------------------------------
# Deixe vazio para desligar. Se preenchido, o LangChain envia traces das
# chamadas pra Langfuse automaticamente (callback handler).
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
