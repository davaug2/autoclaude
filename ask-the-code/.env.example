# =============================================================================
# ask-the-code — exemplo de configuração
# =============================================================================
# Copie para .env e preencha. NUNCA faça commit do .env.

# -----------------------------------------------------------------------------
# repo-sync
# -----------------------------------------------------------------------------
GIT_REPO_URL=https://github.com/sua-org/seu-repo.git
GIT_BRANCH=main
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SYNC_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Confira o id atual em https://docs.claude.com/en/docs/models
ANTHROPIC_MODEL=claude-opus-4-7
AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT_S=180
REWRITE_MAX_TOKENS=2048
MAX_REWRITE_ATTEMPTS=2
DIAGNOSTICS_AGENT_MAX_ITERS=30

# -----------------------------------------------------------------------------
# Rate limiting (Redis)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_HOUR=30
DIAGNOSTICS_RATE_LIMIT_PER_HOUR=60

# Set false to disable the diagnostics pipeline and stop spinning up its MCPs.
ENABLE_DIAGNOSTICS=true

# -----------------------------------------------------------------------------
# Pipeline business — claude-code-mcp
# -----------------------------------------------------------------------------
MAX_READ_BYTES=262144
MAX_GREP_RESULTS=200
MAX_GLOB_RESULTS=500

# -----------------------------------------------------------------------------
# Pipeline diagnostics — companies-mcp (Postgres)
# -----------------------------------------------------------------------------
# Use um USUÁRIO READ-ONLY do Postgres. NUNCA o usuário de aplicação.
COMPANIES_DB_URL=postgresql://readonly:CHANGE_ME@db.internal:5432/companies
COMPANIES_TABLE=companies
COMPANIES_ID_COLUMN=id
COMPANIES_NAME_COLUMN=name
COMPANIES_STATUS_COLUMN=status
COMPANIES_CREATED_AT_COLUMN=created_at
COMPANIES_MAX_LIMIT=5

# -----------------------------------------------------------------------------
# Pipeline diagnostics — postgres-mcp (Postgres)
# -----------------------------------------------------------------------------
OPERATIONS_DB_URL=postgresql://readonly:CHANGE_ME@db.internal:5432/operations
CONVERSATIONS_TABLE=conversations
CONFIGS_TABLE=company_configs
MAX_CONVERSATIONS=100
MAX_CONFIGS=50
# Regex (case-insensitive) cujo MATCH em config_key dispara mascaramento do valor.
SENSITIVE_KEY_PATTERN=(secret|token|password|api_key|apikey)

# -----------------------------------------------------------------------------
# Pipeline diagnostics — mongo-mcp (MongoDB)
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://readonly:CHANGE_ME@mongo.internal:27017/operations?authSource=operations
MONGO_DB=operations
MONGO_AUDIT_COLLECTION=audit_logs
MONGO_MESSAGES_COLLECTION=messages
MAX_AUDIT_LOGS=100
MAX_MESSAGES=200
MAX_MESSAGE_SEARCH=50

# -----------------------------------------------------------------------------
# Pipeline diagnostics — s3-mcp (S3 chatbot flows)
# -----------------------------------------------------------------------------
# IAM com APENAS:
#   s3:ListBucket  no bucket (Prefix=flows/)
#   s3:GetObject   em arn:aws:s3:::<bucket>/flows/*
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
S3_BUCKET=chatbot-flows
MAX_FLOW_BYTES=1048576
MAX_FLOWS=100

# -----------------------------------------------------------------------------
# Input scanners (LLM Guard) — aplicam-se a ambos pipelines
# -----------------------------------------------------------------------------
INPUT_TOKEN_LIMIT=2000
PROMPT_INJECTION_THRESHOLD=0.5
INPUT_TOXICITY_THRESHOLD=0.7

# Tópicos banidos para /ask/business
BANNED_TOPICS=personal advice,medical,legal,financial advice

# Tópicos banidos para /ask/diagnostics (intenção destrutiva)
DIAGNOSTICS_BANNED_TOPICS=delete data,drop table,modify records,change configuration

# -----------------------------------------------------------------------------
# Output scanners (LLM Guard)
# -----------------------------------------------------------------------------
OUTPUT_TOXICITY_THRESHOLD=0.7
OUTPUT_BIAS_THRESHOLD=0.7
MALICIOUS_URL_THRESHOLD=0.7

# Regex (JSON list) que BLOQUEIAM a resposta inteira nos dois pipelines
OUTPUT_BLOCK_REGEX_PATTERNS=[]

# Regex (JSON list) que são SANITIZADOS (substituídos por [REDACTED]) nos dois pipelines
OUTPUT_REDACT_REGEX_PATTERNS=[]

ENABLE_NO_REFUSAL=false

# -----------------------------------------------------------------------------
# Observabilidade (Langfuse — opcional)
# -----------------------------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
